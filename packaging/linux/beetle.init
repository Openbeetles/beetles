#!/bin/sh
# SysV init example for Buildroot / busybox inittab. Adjust paths and user.
# Provides Debian/LSB metadata too, so `systemctl enable beetle` does not fail on
# distros that sync unit enablement through `update-rc.d`.
### BEGIN INIT INFO
# Provides:          beetle
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Beetle supervisor
# Description:       Start and stop the Beetle supervisor process
### END INIT INFO
# chkconfig: 2345 90 10
# description: Beetle supervisor

DAEMON="/opt/beetle/current/beetle"
PIDFILE="/var/run/beetle.pid"

case "$1" in
  start)
    echo "Starting beetle..."
    start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- supervise || exit 1
    ;;
  stop)
    echo "Stopping beetle..."
    start-stop-daemon -K -p "$PIDFILE" || exit 1
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
