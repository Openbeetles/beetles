# beetle - ESP32-S3 target
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM 8MB Octal；ALWAYSINTERNAL=32（仅最小对象优先走 internal）+ RESERVE_INTERNAL=96KB。
# P1/P2 已收窄常驻执行面并把关键 TLS/WSS 线程收回到受控任务面，
# 但 Beetle 在启动峰值仍可能出现 agent + voice + ws + sender + config bootstrap 并存，
# 因此这里只做保守回收。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
# Allow selected IDF networking/system .bss sections (lwIP/net80211/libpp/wpa_supplicant, etc.)
# to live in PSRAM, reducing persistent internal SRAM pressure without touching task stacks.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MEMTEST=n

# AP+STA 模式双接口共享 RX 缓冲；过低导致 STA 丢帧、路由器发 DELBA 反复断连。
# ESP-IDF 默认 10/32/6，此处保守取半，SRAM 增量 ~4.8KB（static 3→6 × 1600B）。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
# WSS + 多路 HTTP（sender/agent/心跳）并发时需更多 socket，避免 esp-tls Failed to create socket
CONFIG_LWIP_MAX_SOCKETS=16

CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# P3: 在保持 16K/4K 片长口径不变的前提下，启用动态 TX/RX buffer，
# 让 TLS 连接空闲时及时归还大块 internal/external heap。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# 证书包：包含常见根证书，支持百度等 API 的 TLS 验证
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# mbedTLS 4.0 (IDF v6.0) 默认不处理交叉签名链；百度/GlobalSign 等 CDN 常返回交叉签名根证书，
# 不启用此选项会导致 "No matching trusted root certificate found"。heap 增量 ~700B，可忽略。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# Current firmware does not expose server-side WebSocket endpoints on the ESP
# config API; keep HTTP only to avoid linking unused ws server support.
# CONFIG_HTTPD_WS_SUPPORT is not set

# Release-size build: drop on-device GDB stub and dynamic log plumbing.
# These only help local debugging and do not affect runtime business logic.
# CONFIG_ESP_GDBSTUB_ENABLED is not set
# Strip per-tag runtime log cache/list machinery first; this is what keeps
# LOG_DYNAMIC_LEVEL_CONTROL alive in IDF 6.0.
CONFIG_LOG_TAG_LEVEL_IMPL_NONE=y
# CONFIG_LOG_DYNAMIC_LEVEL_CONTROL is not set
# CONFIG_LOG_IN_IRAM is not set

# mbedTLS size trims that preserve current usage:
# - app code only uses TLS client mode
# - trust comes from crt bundle attach
# - no client cert/key generation, CSR/CRL parsing, or TLS server mode in app code
# CONFIG_MBEDTLS_ERROR_STRINGS is not set
CONFIG_MBEDTLS_X509_REMOVE_INFO=y
# CONFIG_MBEDTLS_PEM_WRITE_C is not set
# WPA supplicant (WPA3/EAP) exports DER keys through mbedTLS PK write helpers.
CONFIG_MBEDTLS_PK_WRITE_C=y
# CONFIG_MBEDTLS_X509_CRL_PARSE_C is not set
# CONFIG_MBEDTLS_X509_CSR_PARSE_C is not set
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_MBEDTLS_SSL_CACHE_C is not set
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
# CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS is not set
# CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS is not set

CONFIG_PARTITION_TABLE_CUSTOM=y
# CMake 工程根目录为 esp-idf-sys 的 out/，相对路径需指向仓库根目录的 partitions.csv（见 IDF partition_table/project_include.cmake）。
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# main 任务栈：P2 后主任务只保留启动装配 + 监管，不再给宽运行态兜底。
# 仍需覆盖 NVS/SPIFFS/WiFi/registry/build_default_registry 等启动链深度，
# 因此从 20000 保守下调到 12288，而不是直接砍到 xiaozhi 的 8192。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# 系统事件任务：显式固定为 4096，避免继续依赖 IDF 默认 2304 的隐式口径。
# Beetle 使用 AP+STA、WiFi/netif/system event 组合路径，保守比默认略高。
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# 任务看门狗超时：单次 LLM 请求+网络延迟可能较长，避免误复位
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# ESP-IDF v6.0 内存优化：将 FreeRTOS 函数放到 Flash，节省 10-20KB 内部 RAM
# 禁用：该配置导致 WiFi 重连时栈溢出（v6.0 的 WiFi/TLS 驱动在 Flash 执行时栈使用增加）
# CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH is not set
# CONFIG_FREERTOS_PLACE_SNAPSHOT_FUNS_INTO_FLASH is not set
